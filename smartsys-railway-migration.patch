+# Railway config-as-code for the SmartSys API (MySQL runs as a separate Railway service).
+[build]
+builder = "DOCKERFILE"
+dockerfilePath = "Dockerfile"
+
+[deploy]
+# /check is a database-independent liveness probe that is exempt from the HTTPS redirect.
+# Monitor /health (database readiness) separately with an uptime checker.
+healthcheckPath = "/check"
+healthcheckTimeout = 120
+restartPolicyType = "ON_FAILURE"
+restartPolicyMaxRetries = 5
