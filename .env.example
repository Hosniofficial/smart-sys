# Local development environment. Copy to .env and replace the required secrets.
APP_ENV=development
APP_DEBUG=true

# XAMPP/MySQL defaults; update DB_PASSWORD if your local MySQL has a password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartsys
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Generate separate values with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=2592000
JWT_ALGORITHM=HS256
CRON_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Optional encryption keys; keep stable after encrypting local data.
# Generate ENCRYPTION_KEY with: openssl rand -base64 32
ENCRYPTION_KEY=
# Set a valid base64-encoded 32-byte key before enabling 2FA.
TWO_FA_ENCRYPTION_KEY=

LOG_LEVEL=debug
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://127.0.0.1:8000
ADMIN_API_URL=http://127.0.0.1:8000/api/v1/admin/subscriptions/cron

# Configure Resend or SMTP before testing email verification and password resets.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM=
SMTP_FROM_NAME=SmartSys
SMTP_TIMEOUT=15
EMAIL_MAX_EXECUTION_TIME=60

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_LOGIN_WINDOW=600
RATE_LIMIT_LOGIN_ATTEMPTS=10

SECURITY_LOGGING_ENABLED=true
SECURITY_LOG_RETENTION_DAYS=365
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
