{
    "name": "smartsys/erp",
    "description": "نظام الإدارة المتكامل الحل الأمثل لإدارة جميع جوانب عملك بكفاءة وسهولة.",
	"license": "proprietary",
    "type": "project",
    "require": {
        "slim/slim": "^4.0",
        "slim/psr7": "^1.6",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^7.0",
        "dompdf/dompdf": "^3.1",
        "pusher/pusher-php-server": "^7.2",
        "monolog/monolog": "^2.11",
        "phpmailer/phpmailer": "^6.10",
        "pimple/pimple": "^3.5",
        "php-di/php-di": "^7.1",
        "nikic/php-parser": "^5.7",
        "stripe/stripe-php": "^19.4",
        "sentry/sentry": "^4.0",
        "pragmarx/google2fa": "^9.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "api/v1/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    }
}
