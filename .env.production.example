# ============================================================================
# SmartSys ERP - Production Environment Variables (Railway)
# ============================================================================
# Set these on the Railway API service (Variables tab). Never commit real values.
# Railway reference variables (${{MySQL.MYSQLHOST}} ...) resolve at deploy time, so the
# database credentials are not copied by hand. "MySQL" is the name of the MySQL service.
# Full guide: docs/RAILWAY_DEPLOYMENT.md
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
# PORT is injected by Railway and the container follows it automatically; do not set it by hand.
# Leave APP_BASE_PATH unset (the API is served at the domain root: /api/v1/...).
FRONTEND_URL=https://your-frontend.pages.dev
REFRESH_COOKIE_PATH=/api/v1/auth

# ---------------------------------------------------------------------------
# Database (Railway MySQL, private network)
# ---------------------------------------------------------------------------
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# Private-network traffic stays inside Railway; leave TLS options empty.
# For an external database use VERIFY_IDENTITY with DB_SSL_CA pointing at the provider CA file.
DB_SSL_MODE=

# ---------------------------------------------------------------------------
# JWT / secrets (keep the values you already use in production when migrating)
# ---------------------------------------------------------------------------
# Generate: openssl rand -hex 32   (the two JWT secrets must differ)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=2592000
JWT_ALGORITHM=HS256

# Generate: php scripts/generate_2fa_key.php   (losing it makes stored 2FA secrets unreadable)
TWO_FA_ENCRYPTION_KEY=CHANGE_ME_RUN_PHP_SCRIPTS_GENERATE_2FA_KEY
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_TO_SECURE_KEY
# Generate: openssl rand -hex 32   (sent as the X-Cron-Token header by the scheduler)
CRON_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_VALUE

# ---------------------------------------------------------------------------
# Persistent storage (attach a Railway Volume to the API service and mount it at /data)
# ---------------------------------------------------------------------------
# Private warranty attachments are stored outside the web root in $PERSIST_DIR/uploads and
# logos in $PERSIST_DIR/logos. Without a volume, uploaded files are lost on every redeploy.
PERSIST_DIR=/data

# ---------------------------------------------------------------------------
# CORS (only needed when the browser calls the API origin directly)
# ---------------------------------------------------------------------------
# With the Cloudflare Pages /api proxy the browser is same-origin and CORS is not used.
CORS_ALLOW_ALL=false
CORS_ALLOWED_ORIGINS=https://your-frontend.pages.dev

# ---------------------------------------------------------------------------
# Reverse proxy / client IP (Railway edge)
# ---------------------------------------------------------------------------
TRUST_PROXY=true
# Railway does not publish fixed proxy addresses. Its edge reaches the container from private
# 100.x (IPv4) or fc00::/7 (IPv6) addresses. Keep the API reachable only through Railway's edge.
TRUSTED_PROXY_IPS=100.0.0.0/8,fc00::/7,::1,127.0.0.1
# Railway overwrites X-Real-IP with the real client address at its edge.
CLIENT_IP_HEADER=X-Real-IP
# When the Cloudflare Pages proxy is in front, set the SAME random value here and in Cloudflare
# (Pages -> Variables and secrets). The proxy then forwards the real visitor IP.
# Generate: openssl rand -hex 32
PROXY_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW=600

# ---------------------------------------------------------------------------
# Logging & monitoring (logs go to stderr, visible in Railway Logs)
# ---------------------------------------------------------------------------
LOG_LEVEL=info
SESSIONS_DEBUG=0
SECURITY_LOGGING_ENABLED=true
SECURITY_LOG_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# HTTPS (keep enabled: it also controls the Secure flag of the refresh cookie)
# ---------------------------------------------------------------------------
HTTPS_ENFORCEMENT_ENABLED=true
HTTPS_REDIRECT=true

# ---------------------------------------------------------------------------
# Health
# ---------------------------------------------------------------------------
# /check = liveness (Railway healthcheck, no database); /health = database readiness.
HEALTH_DETAILS_TOKEN=

# ---------------------------------------------------------------------------
# Platform administration: Railway status and volume backup visibility
# ---------------------------------------------------------------------------
# Create a Railway Project Access Token scoped to the production environment.
# The application runs read-only GraphQL queries; keep the token on the API service only.
RAILWAY_PROJECT_ACCESS_TOKEN=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_API_SERVICE_ID=
RAILWAY_DATABASE_SERVICE_ID=
# Comma-separated Railway volume INSTANCE IDs (for example MySQL and API uploads).
RAILWAY_VOLUME_INSTANCE_IDS=

# ---------------------------------------------------------------------------
# Sentry (optional)
# ---------------------------------------------------------------------------
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ---------------------------------------------------------------------------
# Email (Resend primary, SMTP fallback)
# ---------------------------------------------------------------------------
# Resend HTTP API — recommended on Railway/cloud hosts that block SMTP ports.
# Create a free account at https://resend.com, add your domain, then copy the API key.
# When RESEND_API_KEY is set it is used; otherwise the SMTP_* variables below apply.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=SmartSys ERP

# ============================================================================
# IMPORTANT
# ============================================================================
# 1. Never commit real secrets. Use different values for staging and production.
# 2. Keep JWT_SECRET, JWT_REFRESH_SECRET, TWO_FA_ENCRYPTION_KEY and ENCRYPTION_KEY unchanged when
#    moving hosts, otherwise sessions are invalidated and stored 2FA secrets become unreadable.
# 3. Replace every CHANGE_ME_* value before the first deployment.
# ============================================================================
