# ============================================================================
# SmartSys ERP - Production Environment Variables (Render)
# ============================================================================
# Copy this file and set the values on Render dashboard
# Dashboard: https://dashboard.render.com/web/YOUR_SERVICE/env
# ============================================================================

# ---------------------------------------------------------------------------
# Application Configuration
# ---------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false              # MUST be false in production (security risk)
APP_BASE_PATH=               # Empty for Render (no base path needed)
APP_URL=https://your-frontend.pages.dev  # Frontend URL (for emails, links)

# ---------------------------------------------------------------------------
# Database Configuration (Aiven MySQL)
# ---------------------------------------------------------------------------
DB_HOST=your-database-host.aivencloud.com
DB_PORT=10371
DB_DATABASE=defaultdb
DB_USERNAME=your_username
DB_PASSWORD=CHANGE_ME_TO_YOUR_DATABASE_PASSWORD
DB_SSL_MODE=REQUIRED

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ACCESS_TOKEN_EXPIRY=3600       # 1 hour
JWT_REFRESH_TOKEN_EXPIRY=2592000   # 30 days
JWT_ALGORITHM=HS256

# ---------------------------------------------------------------------------
# Security & Encryption
# ---------------------------------------------------------------------------
# Generate: php scripts/generate_2fa_key.php
TWO_FA_ENCRYPTION_KEY=CHANGE_ME_RUN_PHP_SCRIPTS_GENERATE_2FA_KEY

# General encryption key (for other sensitive data)
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_TO_SECURE_KEY

# Cron authentication token
# Generate: openssl rand -hex 32
CRON_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_VALUE

# ---------------------------------------------------------------------------
# CORS Configuration
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://your-frontend.pages.dev

# ---------------------------------------------------------------------------
# Proxy Configuration (Render)
# ---------------------------------------------------------------------------
TRUST_PROXY=true
TRUSTED_PROXY_IPS=::1,127.0.0.1

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW=600

# ---------------------------------------------------------------------------
# Logging & Monitoring
# ---------------------------------------------------------------------------
LOG_LEVEL=info              # NOT debug in production
LOG_CHANNEL=daily
SESSIONS_DEBUG=0            # Disable debug logs

# ---------------------------------------------------------------------------
# Security Logging
# ---------------------------------------------------------------------------
SECURITY_LOGGING_ENABLED=true
SECURITY_LOG_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# HTTPS Enforcement
# ---------------------------------------------------------------------------
HTTPS_ENFORCEMENT_ENABLED=true
HTTPS_REDIRECT=true

# ---------------------------------------------------------------------------
# Health Check
# ---------------------------------------------------------------------------
# Token for /health/details endpoint (optional)
# Generate: openssl rand -hex 16
HEALTH_DETAILS_TOKEN=

# ---------------------------------------------------------------------------
# Admin & Cron URLs
# ---------------------------------------------------------------------------
API_BASE_URL=https://your-api.onrender.com/api/v1
ADMIN_API_URL=https://your-api.onrender.com/api/v1/admin/subscriptions/cron

# ---------------------------------------------------------------------------
# Sentry Error Tracking (Optional)
# ---------------------------------------------------------------------------
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Email Configuration (Optional - if using email features)
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SmartSys ERP

# ============================================================================
# IMPORTANT NOTES
# ============================================================================
# 1. NEVER commit real secrets to version control
# 2. Use different keys for dev/staging/production
# 3. Rotate secrets regularly (every 90 days)
# 4. Store backups of encryption keys securely
# 5. Losing TWO_FA_ENCRYPTION_KEY = losing all 2FA secrets
# 6. Set all CHANGE_ME_* values before first deployment
# ============================================================================
