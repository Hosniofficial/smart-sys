# ========================================
# SMARTSYS ERP - Git Ignore Rules
# ========================================

# -------- SECURITY: NEVER COMMIT --------
.env
.env.local
.env.*.local
.env.backup
.env.production.local
.env.staging
secretsfile.txt
private_key.pem
*.p12

# -------- DEPENDENCIES --------
/vendor/
/node_modules/
yarn.lock

# -------- LOGS --------
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -------- TEMPORARY FILES --------
/tmp/
/temp/
*.tmp
*.cache
*.bak
*.backup
*.orig

# -------- OS & EDITOR --------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.sublime-project
*.sublime-workspace

# -------- BUILD & DIST --------
/dist/
/build/
*.min.js
*.min.css
/erp-frontend/dist/
/erp-frontend/.vite/
/erp-frontend/.nuxt/
/erp-frontend/.output/

# -------- FRONTEND --------
/erp-frontend/node_modules/

# -------- PHP SPECIFIC --------
.phpunit.result.cache
coverage/
.coverage

# -------- UPLOADS & DYNAMIC FILES --------
/public/uploads/
/api/public/uploads/

# -------- DATABASE --------
*.sql
*.sql.gz
*.dump
*.sqlite
*.db
/tests/Integration/Fixtures/smartsys-local-test.sql
!/tests/Integration/Fixtures/mysql_schema.sql
/database/production/*manifest*.json

# -------- ARCHIVES --------
*.rar
*.zip
*.tar.gz
*.7z

# -------- MISC --------
.gitkeep!
package.json.bak
composer.json.bak
